# Secrets — never commit
.env

# Large binary raster data — reproducible by running pipeline scripts
**/*.tif

# Raw LiDAR point cloud tiles (~1.57 GB) — reproducible via lidar/build_lidar_pointcloud.py
lidar/data/raw/*.laz

# Site3 raw LiDAR bbox cache — reproducible via lidar/cache_bbox_points.py
site3_gee_creek/lidar/data/bbox_cache/*.npz

# USGS 3DHP national Flow Network Derivatives archive (880MB zip + 1.68GB extracted CSV) —
# fetched for TASK_3DHP_FLOW_NETWORK_DERIVATIVES.md, never actually consumed by any script;
# re-fetchable from source, not worth versioning
hydrography/data/fnd/*.zip
hydrography/data/fnd/*.csv

# Exported mesh/point-cloud viewer assets — reproducible via their export scripts
# (duplicated between lidar/data/ and viewer/data/; large, regenerable, not source data)
**/dense_test_area_mesh*.obj
**/bridge_mesh_*.obj
**/lidar_pointcloud*.bin

# Site3's stream_network.geojson is anomalously large (207MB vs. main AOI's 1MB for the same
# product) — reproducible via dem_hydro.py; worth investigating separately, not worth versioning
# as-is either way
site3_gee_creek/dem/data/hydro/stream_network.geojson

# HTTP cache directories (pynhd aiohttp cache, etc.)
cache/

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd

# Project-scoped virtual environment (2026-07-23, Python 3.11 via uv — see requirements.txt)
.venv/

# OS artifacts
.DS_Store

# Trained model weights — large, regenerable by research/train_*.py
*.pt

# Private planning document: contains third-party names, contact details and
# editor correspondence. Kept local, deliberately not published.
HYDROLINK_PAPER_PLAN.md
HYDROLINK_abstract_draft.md
**/HYDROLINK_*
