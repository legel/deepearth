{
  "launch": {
    "production": "python -m deepearth.core.train --cache /path/to/deepcal --device cuda --steps 2291 --seed 1337",
    "tracked": "python -m dashboard.tracker --cache /path/to/deepcal --device cuda --steps 2291 --seed 1337 --tag exp1",
    "record_default_steps": 8000,
    "comparable_public_steps": 2291,
    "promotion_seeds": [
      1337,
      1338
    ]
  },
  "optimization": {
    "optimizer": "AdamW",
    "schedule": "cosine annealing over the requested step budget",
    "batch": 256,
    "learning_rate": 0.0005,
    "weight_decay": 0.001,
    "hide_probability": 0.5,
    "reader_phase": "last 100 steps",
    "graph_learning_rate_scale": 0.02
  },
  "outputs": [
    {
      "type": "stdout",
      "format": "step {step} loss {loss:.4f} elapsed {seconds:.1f}s"
    },
    {
      "type": "file",
      "format": "--output checkpoint.pt writes the final state_dict"
    },
    {
      "type": "stdout",
      "format": "BENCHMARK RECEIPT: JSON with protocol, full scores, harmonic, and arithmetic"
    }
  ],
  "promotion": {
    "evaluator": "autoresearch/evaluate.py",
    "record": "autoresearch/champion_scores.json",
    "primary": "harmonic mean",
    "companion": "arithmetic mean",
    "rule": "Use the unchanged evaluator, fixed 2,291-step budget, and seeds 1337 and 1338."
  }
}
