*.gguf
*.bin
*.safetensors
*.pt
*.pth

# Logs
*.log

# Environment variables — credentials. The Ensue token lives in autoresearch/.env; the bare
# `.env` pattern matches at any depth, but spell it out so nobody has to wonder.
.env
.env.local
autoresearch/.env
**/.env
# autoresearch working state (local only)
# results.tsv = per-experiment scores; autoresearch.md defines it as untracked local state
*.pt
__pycache__/
results.tsv
autoresearch/main/records/fusion_controls.json

# The corpus lives at autoresearch/data/ and is ~53GB on the box. Its GENERATED artifacts are ignored
# (by the *.npz / *.pt / *.pkl rules above, plus the caches below), but the BUILD RECIPES in
# autoresearch/data/deepcal — build_*.py, env_priors/, PIPELINE.md, data_provenance.yaml — are source
# code and stay tracked. Do not blanket-ignore autoresearch/data or the pipeline disappears from git.
/data/
autoresearch/data/**/gbif_tokens/
autoresearch/data/**/prepared_*.pt
autoresearch/data/**/derived/
autoresearch/data/lfmc/*.csv
autoresearch/data/**/e4d_runs_mirror/

# compiled CUDA artifacts (regenerated by install.sh)
encoders/spacetime/hashencoder/build/
**/*.so
deepearth

# agent scratch: one-off scripts, logs, dumps. Disposable by definition -- see
# agents/earth4d/program.md "Experiment version control". Scratch beside source is how 83 untracked
# files, 6 hand-rolled .pre-X backups and 21 champion_*.yaml variants accumulated.
scratch/
**/scratch/
*.pre-*
*.bak
*.orig
