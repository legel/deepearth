# Ensue credentials for the autoresearch loops. Copy to autoresearch/.env and fill in.
# autoresearch/.env is gitignored — NEVER commit the real token.
#
# The swarm's shared memory: every loop upserts its keys here (spacetime uses
# LOOP-earth4d-<capability>). Without it, --ensue fails loudly rather than leaving
# the board stale, so a run cannot silently go unpublished.
ENSUE_API_TOKEN=
